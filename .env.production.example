# ShipSpace production environment example
# Copy to your secret manager or deployment environment and replace every CHANGE_ME value.
# Do not commit real secrets.

# Runtime
SPRING_PROFILES_ACTIVE=production
PORT=8080
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_SHIPSPACE=INFO

# Public origins and CORS
FRONTEND_ORIGIN=https://CHANGE_ME_FRONTEND_DOMAIN
CORS_ALLOWED_ORIGINS=https://CHANGE_ME_FRONTEND_DOMAIN

# MongoDB
MONGODB_URI=mongodb+srv://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_CLUSTER/shipspace?retryWrites=true&w=majority

# Redis
REDIS_HOST=CHANGE_ME_REDIS_HOST
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# JWT
JWT_SECRET=CHANGE_ME_64_PLUS_CHAR_RANDOM_SECRET
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# GitHub OAuth
GITHUB_CLIENT_ID=CHANGE_ME_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=CHANGE_ME_GITHUB_CLIENT_SECRET
GITHUB_REDIRECT_URI=https://CHANGE_ME_FRONTEND_DOMAIN/auth/callback
ADMIN_GITHUB_IDS=CHANGE_ME_COMMA_SEPARATED_NUMERIC_GITHUB_IDS

# Multibase
MULTIBASE_API_URL=https://CHANGE_ME_MULTIBASE_API_URL
MULTIBASE_API_KEY=CHANGE_ME_MULTIBASE_API_KEY

# Feature flags
SWAGGER_ENABLED=false
RATE_LIMIT_ENABLED=true
CACHE_ENABLED=true
DECAY_ENABLED=true
AUDIT_ENABLED=true
DEMO_MODE=false

# Actuator and observability
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,prometheus
MANAGEMENT_TRACING_ENABLED=true
ZIPKIN_ENDPOINT=https://CHANGE_ME_TRACE_COLLECTOR/api/v2/spans
