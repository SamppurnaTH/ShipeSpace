# ShipSpace Backend Environment Variables
# Copy to .env and configure for your environment

# MongoDB
MONGODB_URI=mongodb://localhost:27017/shipspace

# JWT
JWT_SECRET=your-secret-key-minimum-256-bits-for-production
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost:3000/auth/callback

# CORS - comma-separated origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Server
PORT=8080

# Optional: Redis, Rate Limiting, etc.
REDIS_HOST=localhost
REDIS_PORT=6379
RATE_LIMIT_ENABLED=true
