# ShipSpace Backend — Environment Variables
# Copy this file to .env and fill in all REQUIRED values before starting.
# Never commit .env to version control.

# ── REQUIRED ──────────────────────────────────────────────────────────────────

# MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/shipspace

# JWT — use a cryptographically random string of at least 32 characters
# Generate one with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_use_openssl_rand_hex_32

# GitHub OAuth application credentials
# Create an app at https://github.com/settings/developers
GITHUB_CLIENT_ID=CHANGE_ME
GITHUB_CLIENT_SECRET=CHANGE_ME
GITHUB_REDIRECT_URI=http://localhost:3000/auth/callback

# ── OPTIONAL (have safe defaults) ─────────────────────────────────────────────

# Server port
PORT=8080

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# JWT token lifetimes (milliseconds)
JWT_EXPIRATION=86400000        # 24 hours
JWT_REFRESH_EXPIRATION=604800000  # 7 days

# Multibase image storage
MULTIBASE_API_URL=http://localhost:5001
MULTIBASE_API_KEY=

# Feature flags
SWAGGER_ENABLED=false          # Set to true in dev/staging only
RATE_LIMIT_ENABLED=true
CACHE_ENABLED=true
DECAY_ENABLED=true
AUDIT_ENABLED=true
